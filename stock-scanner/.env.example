# Copy to .env and fill in. Load with:  set -a; source .env; set +a
# (or configure these as real environment variables in your host / cron).
# NEVER commit the real .env — it's gitignored.

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# For Gmail, create an App Password (Account > Security > App passwords),
# NOT your normal login password.
SMTP_PASS=your_app_password
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com,another@example.com

# --- Market data provider ---
# "groww" (live, accurate NSE/BSE) or "yfinance" (free, delayed).
# Leave blank to auto-pick: groww if GROWW_* below are set, else yfinance.
DATA_PROVIDER=groww

# --- Groww API (get these from Groww > Trade API > Generate API Key) ---
# Option A (preferred): paste an access token
GROWW_ACCESS_TOKEN=
# Option B: API key + secret (the SDK generates the token for you)
GROWW_API_KEY=
GROWW_API_SECRET=
# Politeness delay between historical calls, seconds (raise if you hit rate limits)
GROWW_REQUEST_DELAY=0.25

# --- Mutual funds (optional) ---
# Comma-separated AMFI scheme codes to watch, e.g. 120505,118989
# (or put them in data/mf_schemes.csv with a 'SchemeCode' column)
MF_SCHEMES=
